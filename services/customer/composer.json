{
  "name": "tracht-digital-solutions/tds-customer-api",
  "description": "Customer portal data API (projects, invoices, documents, messages) for TDS",
  "type": "project",
  "version": "0.8.3",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-zip": "*",
    "firebase/php-jwt": "^7.0",
    "guzzlehttp/guzzle": "^7.9",
    "php-di/php-di": "^7.0",
    "ramsey/uuid": "^4.7",
    "robmorgan/phinx": "^0.16",
    "slim/psr7": "^1.6",
    "slim/slim": "^4.13",
    "stripe/stripe-php": "^16.0",
    "symfony/mailer": "^7.4",
    "symfony/mime": "^7.4",
    "vlucas/phpdotenv": "^5.6",
    "webklex/php-imap": "^6.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Tds\\CustomerApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tds\\CustomerApi\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "start": "php -S localhost:8004 -t public public/router.php",
    "test": "phpunit",
    "migrate": "phinx migrate -e local",
    "migrate:prod": "phinx migrate -e production"
  }
}
