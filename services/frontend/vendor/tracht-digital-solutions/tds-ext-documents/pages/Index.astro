---
// Documents page, injected into the host build via the manifest's route slot.
// Renders the customer document store (list + upload + download + rename +
// signed links). Company scoping comes from the backend UserContext.
import DocumentList from "../islands/DocumentList.tsx";
---

<section class="tds-page">
  <div class="tds-page__head">
    <h1 class="tds-page__title">Dokumente</h1>
  </div>
  <DocumentList client:load />
</section>
