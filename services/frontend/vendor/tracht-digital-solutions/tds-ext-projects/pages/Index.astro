---
// Projects page, injected into the host build via the manifest's route slot.
// Renders the customer's project list + milestone progress (read-only). Admin
// project management lives behind /admin/projects (admin product target).
import ProjectList from "../islands/ProjectList.tsx";
---

<section class="tds-page">
  <div class="tds-page__head">
    <h1 class="tds-page__title">Projekte</h1>
  </div>
  <ProjectList client:load />
</section>
