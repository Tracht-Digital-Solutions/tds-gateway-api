---
// The TDShop catalogue screen, injected into the host build via the manifest's
// route slot.
import CategoryManager from "../islands/CategoryManager.tsx";
import ProductList from "../islands/ProductList.tsx";
---

<section class="tds-page">
  <div class="tds-page__head">
    <h1 class="tds-page__title">TDShop</h1>
  </div>
  <ProductList client:load />
  {/* Below the catalogue it names: idle rather than load, because nobody opens
      this screen to rename a category first. */}
  <CategoryManager client:idle />
</section>
