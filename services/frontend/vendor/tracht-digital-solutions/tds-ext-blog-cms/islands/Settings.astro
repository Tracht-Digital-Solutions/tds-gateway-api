---
// Blog-CMS settings section, rendered by the base Einstellungen host via
// virtual:frontend-settings. Hosts the BlogSettings island, which reads/writes the
// core runtime settings store (`/admin/settings/blog-cms`): DeepL key,
// auto-translate flag, and the rebuild token — DB-first, env fallback in the
// backend. Secrets are stored AES-256-GCM-encrypted by the core.
import BlogSettings from "./BlogSettings.tsx";
// HYDRATION: `client:visible`, not `client:load`. /einstellungen stacks seven
// settings panels vertically and all but the first are below the fold; eager
// hydration fired seven islands and seven settings fetches on load. The page
// content islands (pages/*.astro) stay `client:load` on purpose — those ARE
// the reason the user navigated.
---

<div class="tds-settings-section__body">
  <h3>Blog-CMS</h3>
  <BlogSettings client:visible />
</div>
