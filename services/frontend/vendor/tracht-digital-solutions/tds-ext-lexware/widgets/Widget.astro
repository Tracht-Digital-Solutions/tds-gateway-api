---
// Lexware dashboard widget shell (server component). Renders card chrome and
// embeds the hydrated island that fetches /lexware/summary.
import WidgetBody from "../islands/WidgetBody.tsx";
// HYDRATION: `client:visible`, not `client:load`. The dashboard renders 13
// widgets; eager hydration meant 13 React roots AND 13 fetches fired on every
// dashboard load, including widgets the user had switched off in their layout
// (which are display:none, so IntersectionObserver never fires for them at
// all). Do not change this back without measuring the dashboard again.
---

<article class="tds-widget">
  <h3 class="tds-widget__title">Lexware-Rechnungen</h3>
  <WidgetBody client:visible />
</article>
