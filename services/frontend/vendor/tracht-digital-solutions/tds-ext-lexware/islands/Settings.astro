// Lexware settings section shell, rendered by the base Einstellungen host via
// virtual:frontend-settings. The island persists into the core settings store
// (/admin/settings/lexware) + offers a connection test.
import LexwareSettings from "./LexwareSettings.tsx";
// HYDRATION: `client:visible`, not `client:load`. /einstellungen stacks seven
// settings panels vertically and all but the first are below the fold; eager
// hydration fired seven islands and seven settings fetches on load. The page
// content islands (pages/*.astro) stay `client:load` on purpose — those ARE
// the reason the user navigated.
---

