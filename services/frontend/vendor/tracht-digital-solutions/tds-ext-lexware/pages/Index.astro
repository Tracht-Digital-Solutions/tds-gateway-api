---
// Lexware billing-hub main page, injected into the host build via the manifest's
// route slot. The full UI is a hydrated React island (tabs: Kunden / Zeit /
// Kontakte / Rechnungen).
import LexwareHub from "../islands/LexwareHub.tsx";
---

<section class="tds-page">
  <div class="tds-page__head">
    <h1 class="tds-page__title">Lexware</h1>
  </div>
  <p class="tds-page__lede">
    Kunden &amp; Projekte, Zeiterfassung zuordnen, Kontakte und Rechnungen an Lexware Office.
  </p>
  <LexwareHub client:load />
</section>
