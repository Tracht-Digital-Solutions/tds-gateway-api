{
  "name": "tracht-digital-solutions/tds-ext-live-chat-cta",
  "description": "Live-Chat-CTA extension (backend Module): live chat + FAQ + docs + public contact form, per-frontend/per-feature config.",
  "type": "library",
  "license": "proprietary",
  "version": "0.1.15",
  "require": {
    "php": ">=8.1",
    "slim/slim": "^4.13",
    "tracht-digital-solutions/tds-frontend-contract": "^1.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "slim/psr7": "^1.6"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/Tracht-Digital-Solutions/tds-frontend-contract-pkg"
    }
  ],
  "autoload": {
    "psr-4": {
      "Tds\\Ext\\LiveChatCta\\": "php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tds\\Ext\\LiveChatCta\\Tests\\": "php/tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "test": "phpunit"
  }
}
