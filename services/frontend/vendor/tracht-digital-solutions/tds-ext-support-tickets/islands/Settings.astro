---
// Support-tickets settings section, rendered by the base Einstellungen host via
// virtual:frontend-settings. Notification toggles (CP4) + the inbound mailbox.
// The status-registry editor still lives on the Tickets page.
import NotificationSettings from "./NotificationSettings.tsx";
import ImapSettings from "./ImapSettings.tsx";
// HYDRATION: `client:visible`, not `client:load`. /einstellungen stacks seven
// settings panels vertically and all but the first are below the fold; eager
// hydration fired seven islands and seven settings fetches on load. The page
// content islands (pages/*.astro) stay `client:load` on purpose — those ARE
// the reason the user navigated.
---

<div class="tds-settings-section__body tds-stack">
  <h3>E-Mail-Benachrichtigungen</h3>
  <NotificationSettings client:visible />

  <h3>E-Mail-Eingang (IMAP)</h3>
  <ImapSettings client:visible />
</div>
