{
  "name": "tracht-digital-solutions/tds-ext-analytics",
  "description": "Besucher-Statistik: consent-gated first-party audience measurement for the TDS public sites (backend Module).",
  "type": "library",
  "license": "proprietary",
  "version": "0.1.2",
  "require": {
    "php": ">=8.1",
    "maxmind-db/reader": "^1.11",
    "slim/slim": "^4.13",
    "tracht-digital-solutions/tds-frontend-contract": "^1.12"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "robmorgan/phinx": "^0.16",
    "slim/psr7": "^1.6"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/Tracht-Digital-Solutions/tds-frontend-contract-pkg"
    }
  ],
  "autoload": {
    "psr-4": {
      "Tds\\Ext\\Analytics\\": "php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tds\\Ext\\Analytics\\Tests\\": "php/tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "test": "phpunit"
  }
}
