# Copy to .env.docker for `docker compose up`. All values are optional — the
# stack boots on dev-safe placeholders without this file — but anything that
# talks to a third party (Resend, Stripe) or must be a real secret belongs
# here. The api container turns these into per-service services/<name>/.env
# files on first boot (a mounted real .env always wins).

# --- database (shared MariaDB, one db per service) -------------------------
DB_USER=tds
DB_PASS=tds
DB_ROOT_PASS=root

# Published gateway port on the host (container always listens on 8000).
API_PORT=8080

# --- shared across services ------------------------------------------------
# ADMIN_TOKEN must match across auth/content/customer (the admin Bearer).
ADMIN_TOKEN=dev-admin-token-change-me
# When running behind the in-container gateway, services reach auth via :8000.
AUTH_API_URL=http://127.0.0.1:8000/auth
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4323,http://localhost:4324

# --- auth ------------------------------------------------------------------
# Leave JWT_PRIVATE_KEY empty to let the container generate a dev keypair.
JWT_PRIVATE_KEY=
JWT_KEY_ID=tds-auth-dev-1
JWT_ISSUER=http://127.0.0.1:8000/auth
COOKIE_DOMAIN=localhost

# --- contact (Resend) ------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=noreply@tracht-digital.de
CONTACT_EMAIL=hallo@tracht-digital.de

# --- content (blog rebuild trigger, optional) ------------------------------
GITHUB_DISPATCH_TOKEN=

# --- customer (Stripe + document signing) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
DOCUMENT_SIGN_SECRET=dev-document-sign-secret-change-me

# --- optional frontends profile host ports ---------------------------------
LANDING_PORT=4321
BLOG_PORT=4322
ADMIN_PORT=4323
CUSTOMER_PORT=4324
