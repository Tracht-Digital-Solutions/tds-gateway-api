# Zero-hop alternative to the PHP gateway: let nginx do the prefix routing
# directly to the upstream ports. Use this OR the PHP gateway, not both.
#
# Trailing-slash semantics: `location /auth/ { proxy_pass http://...:8003/; }`
# strips the /auth prefix (the upstream sees /admin/login). contact-api keeps
# its own /contact path, so it is mapped without stripping.

server {
    listen 80;
    server_name api.tracht-digital.de;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

    # API responses are machine-to-machine — never index. Mirrors the PHP
    # gateway's X-Robots-Tag middleware for this zero-hop mode ("always" so it
    # also lands on 4xx/5xx responses).
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Crawl block (belt-and-suspenders with the header above).
    location = /robots.txt {
        return 200 "User-agent: *\nDisallow: /\n";
        add_header Content-Type text/plain;
    }

    location /auth/ {
        proxy_pass http://127.0.0.1:8003/;
    }

    location /content/ {
        # Everything under /content/ — including /content/uploads/{slug}/{file}
        # (blog cover/body images) — MUST proxy to the PHP upstream. Do NOT add a
        # static `location /content/uploads/ { alias ...; }` shortcut: uploads are
        # user content, and content-api's UploadServeAction is what stamps the
        # anti-XSS response headers (X-Content-Type-Options: nosniff, a sandbox
        # CSP, and Content-Disposition: attachment for image/svg+xml). Serving the
        # files statically would drop all of that and re-expose stored XSS via a
        # crafted SVG. proxy_pass forwards the upstream headers as-is — keep it.
        proxy_pass http://127.0.0.1:8001/;
    }

    location /customer/ {
        proxy_pass http://127.0.0.1:8004/;
    }

    # contact-api's route is literally /contact — forward without stripping.
    location = /contact {
        proxy_pass http://127.0.0.1:8002/contact;
    }

    location = /healthz {
        # Point at the PHP gateway if you run it for aggregated health,
        # or return a static 200 here.
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
