; Run the assembled `build` bundle as five processes. Point the host's
; webserver at the gateway (127.0.0.1:8000); the gateway proxies to the
; services. Adjust paths to wherever the build branch is checked out.
;
; The ports here MUST match the *_UPSTREAM values the gateway is configured
; with (see Procfile / services.json in the build bundle).

[group:tds]
programs=tds-gateway,tds-auth,tds-contact,tds-content,tds-customer

[program:tds-gateway]
command=php -S 127.0.0.1:8000 -t /srv/tds/gateway/public
directory=/srv/tds/gateway
autostart=true
autorestart=true

[program:tds-auth]
command=php -S 127.0.0.1:8003 -t /srv/tds/services/auth/public
directory=/srv/tds/services/auth
autostart=true
autorestart=true

[program:tds-contact]
command=php -S 127.0.0.1:8002 -t /srv/tds/services/contact/public
directory=/srv/tds/services/contact
autostart=true
autorestart=true

[program:tds-content]
command=php -S 127.0.0.1:8001 -t /srv/tds/services/content/public
directory=/srv/tds/services/content
autostart=true
autorestart=true

[program:tds-customer]
command=php -S 127.0.0.1:8004 -t /srv/tds/services/customer/public
directory=/srv/tds/services/customer
autostart=true
autorestart=true
