{
  "name": "tracht-digital-solutions/tds-api-gateway",
  "description": "Single-entry API gateway that routes api.tracht-digital.de/* to the TDS micro-backends (auth, contact, content, customer)",
  "type": "project",
  "license": "proprietary",
  "version": "0.3.2",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "slim/slim": "^4.13",
    "slim/psr7": "^1.6",
    "php-di/php-di": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Tds\\ApiGateway\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tds\\ApiGateway\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "start": "php -S localhost:8000 -t public public/router.php",
    "test": "phpunit"
  }
}
