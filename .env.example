APP_ENV=production

# Internal API wiki (/wiki HTML + /wiki.json for the in-panel admin wiki) is
# gated by EITHER this shared admin token OR a valid admin session cookie
# (see AUTH_API_URL below). ADMIN_TOKEN is the broken-glass / standalone-login
# credential (Bearer, ?token=, or the tds_wiki cookie). When BOTH ADMIN_TOKEN
# and AUTH_API_URL are unset the wiki routes are disabled (404) — never open.
ADMIN_TOKEN=

# Auth-api base URL, used to verify the admin `tds_session` cookie for the
# wiki (the cookie-based admin panel holds no ADMIN_TOKEN). The gateway calls
# `${AUTH_API_URL}/me` and requires isAdmin. In the in-process bundle the host
# .env already sets this (the services use it too). Unset → cookie auth off,
# only ADMIN_TOKEN works. e.g. https://api.tracht-digital.de/auth
AUTH_API_URL=

# Origins allowed to fetch /wiki.json cross-origin (comma-separated). The admin
# panel lives on a different subdomain and sends the session cookie, so its
# origin must be listed here. CORS is emitted ONLY on the wiki route — never on
# the proxied catch-all (each upstream owns its own CORS).
# e.g. https://management.tracht-digital.de
CORS_ALLOWED_ORIGINS=

# How the gateway reaches the backends:
#   inprocess (default) — run each service's Slim app inside this PHP process.
#     A single PHP-FPM app serves the whole surface; there are NO service
#     processes to start or keep alive (the Plesk model). Requires the
#     assembled bundle layout: <bundle>/gateway + <bundle>/services/<name>
#     (each with its own vendor/ + .env). The *_UPSTREAM / *_REWRITE and
#     GATEWAY_*_TIMEOUT keys below are IGNORED in this mode.
#   proxy — relay over HTTP to the loopback `php -S` services (the
#     supervisor/nginx/Docker run modes). Uses *_UPSTREAM / *_REWRITE.
GATEWAY_MODE=inprocess

# inprocess only: where the four services live. Default is <bundle>/services
# (a sibling of the gateway dir). Override only for non-standard layouts.
GATEWAY_SERVICES_DIR=

# inprocess only: auto-apply each service's pending Phinx migrations on the
# first request after a deploy (guarded, once per migration-set, best-effort).
# This keeps the "install + run on Plesk without SSH" model from drifting
# behind new migrations — the web installer only migrates once. Default on.
#   1 (default) — bring every service's schema up to date automatically.
#   0           — never migrate automatically (run migrations yourself).
GATEWAY_AUTO_MIGRATE=1

# Optional: absolute path to a CLI php binary for the migration subprocess.
# Only set this if auto-migration logs "could not start"/binary errors — under
# PHP-FPM the auto-detected binary is usually right, but some hosts need the
# explicit CLI path (e.g. /opt/plesk/php/8.3/bin/php).
GATEWAY_PHP_BINARY=

# Which services the gateway routes to (comma-separated public prefixes).
# Each name maps to a service dir (inprocess) or {NAME}_UPSTREAM/{NAME}_REWRITE
# (proxy); the four known backends have baked defaults, so this works out of
# the box.
GATEWAY_SERVICES=auth,contact,content,customer

# proxy mode only — upstream base URLs (internal host:port the micro-backend
# listens on). REWRITE is prepended to the path after the public prefix is
# stripped: empty for services that mount at root, and /contact for
# contact-api, whose own route is literally /contact. Ignored in inprocess mode.
AUTH_UPSTREAM=http://127.0.0.1:8003
AUTH_REWRITE=
CONTACT_UPSTREAM=http://127.0.0.1:8002
CONTACT_REWRITE=/contact
CONTENT_UPSTREAM=http://127.0.0.1:8001
CONTENT_REWRITE=
CUSTOMER_UPSTREAM=http://127.0.0.1:8004
CUSTOMER_REWRITE=

# proxy mode only — timeouts (seconds). The proxy client is generous for
# uploads/Stripe; the health client is tight so /healthz can't hang on a dead
# upstream. Ignored in inprocess mode (there is no network hop).
GATEWAY_CONNECT_TIMEOUT=2
GATEWAY_TIMEOUT=30
GATEWAY_HEALTH_CONNECT_TIMEOUT=1
GATEWAY_HEALTH_TIMEOUT=2

# Structured request/error logging (one JSON object per line). Every request
# logs at `info`; a failed backend (in-process dispatch error or, in proxy
# mode, a cURL errno + target URL: 7=connection refused, 6=DNS, 28=timeout)
# logs at `error` — that's what a 502 needs to be diagnosable. Dir is gitignored.
# GATEWAY_LOG_FILE: absolute or root-relative path; `off` disables. Default
#   <root>/logs/gateway.log.
# GATEWAY_LOG_LEVEL: debug|info|warning|error|off. Use `warning` in prod to
#   record only failures + down health checks; `info` to trace every request.
GATEWAY_LOG_FILE=logs/gateway.log
GATEWAY_LOG_LEVEL=warning
