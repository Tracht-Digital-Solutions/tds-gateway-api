APP_ENV=production

# Which services the gateway routes to (comma-separated public prefixes).
# Each name maps to {NAME}_UPSTREAM / {NAME}_REWRITE below; the four known
# backends have baked defaults, so this works out of the box.
GATEWAY_SERVICES=auth,contact,content,customer

# Upstream base URLs (internal host:port the micro-backend listens on).
# REWRITE is prepended to the path after the public prefix is stripped — it
# is empty for services that mount at root, and /contact for contact-api,
# whose own route is literally /contact.
AUTH_UPSTREAM=http://127.0.0.1:8003
AUTH_REWRITE=
CONTACT_UPSTREAM=http://127.0.0.1:8002
CONTACT_REWRITE=/contact
CONTENT_UPSTREAM=http://127.0.0.1:8001
CONTENT_REWRITE=
CUSTOMER_UPSTREAM=http://127.0.0.1:8004
CUSTOMER_REWRITE=

# Proxy timeouts (seconds). The proxy client is generous for uploads/Stripe;
# the health client is tight so /healthz can't hang on a dead upstream.
GATEWAY_CONNECT_TIMEOUT=2
GATEWAY_TIMEOUT=30
GATEWAY_HEALTH_CONNECT_TIMEOUT=1
GATEWAY_HEALTH_TIMEOUT=2
