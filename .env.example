APP_ENV=production

# The gateway is a pure transparent router — it holds no secrets and owns no
# routes of its own besides `/` and `/healthz`. The internal API wiki now lives
# in the frontend API (`/wiki.json`), not the gateway.

# CORS for the gateway's OWN two routes (`/` and `/healthz`) — and for nothing
# else. Every proxied path keeps its upstream's policy: a second
# Access-Control-Allow-Origin does not duplicate, it makes the browser reject
# the response outright, so CORS is never added to the catch-all here.
#
# `/healthz` has no upstream, so before this existed nothing set a header on it
# and a cross-origin read was simply blocked — which is what made the four
# sites' /install wizard report "nicht erreichbar" for a completely healthy
# gateway, right next to a green /content/blog.
#
# The first-party *.tracht-digital.de surfaces (apex, www, blog, tools, auth,
# management, app) are ALWAYS allowed; this key only adds to them, e.g.
# http://localhost:4321 in dev. A stale file can therefore never lock the
# wizard out of the health check it exists to run.
CORS_ALLOWED_ORIGINS=

# How the gateway reaches the backends:
#   inprocess (default) — run each service's Slim app inside this PHP process.
#     A single PHP-FPM app serves the whole surface; there are NO service
#     processes to start or keep alive (the Plesk model). Requires the
#     assembled bundle layout: <bundle>/gateway + <bundle>/services/<name>
#     (each with its own vendor/ + .env). The *_UPSTREAM / *_REWRITE and
#     GATEWAY_*_TIMEOUT keys below are IGNORED in this mode.
#   proxy — relay over HTTP to the loopback `php -S` services (the
#     supervisor/nginx/Docker run modes). Uses *_UPSTREAM / *_REWRITE.
GATEWAY_MODE=inprocess

# inprocess only: where the services live. Default is <bundle>/services (a
# sibling of the gateway dir). Override only for non-standard layouts.
GATEWAY_SERVICES_DIR=

# inprocess only: auto-apply auth + customer's pending Phinx migrations on the
# first request after a deploy (guarded, once per migration-set, best-effort).
# This keeps the "install + run on Plesk without SSH" model from drifting
# behind new migrations — the web installer only migrates once. The frontend
# service (tds-core-frontend-api) runs its OWN in-process migrator over its
# composed extensions, so it is not driven from here. Default on.
#   1 (default) — bring auth + customer's schema up to date automatically.
#   0           — never migrate automatically (run migrations yourself).
GATEWAY_AUTO_MIGRATE=1

# Optional: absolute path to a CLI php binary for the migration subprocess.
# Only set this if auto-migration logs "could not start"/binary errors — under
# PHP-FPM the auto-detected binary is usually right, but some hosts need the
# explicit CLI path (e.g. /opt/plesk/php/8.3/bin/php).
GATEWAY_PHP_BINARY=

# Which services the gateway routes to (comma-separated public prefixes). Each
# name maps to a service dir (inprocess) or {NAME}_UPSTREAM/{NAME}_REWRITE
# (proxy); the current backends have baked defaults, so this works out of the box.
GATEWAY_SERVICES=auth,customer,frontend

# The catch-all upstream: any path that doesn't match a prefix above is
# forwarded to this service VERBATIM (nothing stripped). `frontend`
# (tds-core-frontend-api) owns the whole root namespace except /auth and
# /customer — its module routes (/tickets, /tools, /admin/settings, /me/…,
# /wiki.json, …) live at root. Set to '' to disable the catch-all (unmatched
# paths 404, the pre-cutover behaviour).
GATEWAY_DEFAULT_SERVICE=frontend

# proxy mode only — upstream base URLs (internal host:port the backend listens
# on). REWRITE is prepended to the path after the public prefix is stripped;
# empty for every current service (all mount at root). Ignored in inprocess mode.
AUTH_UPSTREAM=http://127.0.0.1:8003
AUTH_REWRITE=
CUSTOMER_UPSTREAM=http://127.0.0.1:8004
CUSTOMER_REWRITE=
FRONTEND_UPSTREAM=http://127.0.0.1:8100
FRONTEND_REWRITE=

# proxy mode only — timeouts (seconds). The proxy client is generous for
# uploads/Stripe; the health client is tight so /healthz can't hang on a dead
# upstream. Ignored in inprocess mode (there is no network hop).
GATEWAY_CONNECT_TIMEOUT=2
GATEWAY_TIMEOUT=30
GATEWAY_HEALTH_CONNECT_TIMEOUT=1
GATEWAY_HEALTH_TIMEOUT=2

# Structured request/error logging (one JSON object per line). Every request
# logs at `info`; a failed backend (in-process dispatch error or, in proxy
# mode, a cURL errno + target URL: 7=connection refused, 6=DNS, 28=timeout)
# logs at `error` — that's what a 502 needs to be diagnosable. Dir is gitignored.
# GATEWAY_LOG_FILE: absolute or root-relative path; `off` disables. Default
#   <root>/logs/gateway.log.
# GATEWAY_LOG_LEVEL: debug|info|warning|error|off. Use `warning` in prod to
#   record only failures + down health checks; `info` to trace every request.
GATEWAY_LOG_FILE=logs/gateway.log
GATEWAY_LOG_LEVEL=warning
